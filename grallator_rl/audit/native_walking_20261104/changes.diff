+    args=parser.parse_args()
+    root=Path(__file__).resolve().parents[1]
+    for base in (root/'src',root/'scripts',root/'tests'):
+        for source in base.rglob('*.py'):
+            ast.parse(source.read_text(),filename=str(source))
